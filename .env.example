# Copy to .env and fill in real values. .env is gitignored.

# REQUIRED in production. HMAC signing key for session tokens.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# Optional. Comma-separated list of allowed CORS origins.
# Leave empty when the frontend is served from the same Express server.
CORS_ORIGIN=

# Optional. Number of reverse-proxy hops in front of the app
# (e.g. 1 when behind Tailscale / an ingress proxy). Needed for correct
# client-IP detection in rate limiting.
TRUST_PROXY=

# Optional. Password for the auto-seeded "admin" account on first run.
# If unset, "admin123" is used and a warning is logged — change it after first login.
ADMIN_INITIAL_PASSWORD=

# Optional overrides
# PORT=5000
# DATA_DIR=/app/data
