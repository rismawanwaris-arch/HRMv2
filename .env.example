# Copy to .env and fill in real values. .env is gitignored.

# REQUIRED in production. HMAC signing key for session tokens.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# Optional. Comma-separated list of allowed CORS origins.
# Leave empty when the frontend is served from the same Express server.
CORS_ORIGIN=

# Optional. Number of reverse-proxy hops in front of the app
# (e.g. 1 when behind Tailscale / an ingress proxy). Needed for correct
# client-IP detection in rate limiting.
TRUST_PROXY=

# Optional but strongly recommended. Enables at-rest encryption of sensitive
# columns (NIK, NPWP, bank account, BPJS, health history/allergies/medications).
# Use a 64-char hex string: openssl rand -hex 32
# WARNING: losing this key makes the encrypted data unrecoverable. Back it up.
# Existing plaintext rows are migrated automatically on the next startup.
DATA_ENCRYPTION_KEY=

# REQUIRED on first-ever production startup (min 12 chars) to seed the initial "admin" account.
ADMIN_INITIAL_PASSWORD=

# Optional: set to 127.0.0.1 when exposing the app only through a local HTTPS reverse proxy
# (Nginx / Caddy / Cloudflare Tunnel). Leave empty / 0.0.0.0 for direct LAN/ZimaOS access.
# BIND_HOST=127.0.0.1

# Optional: mobile app attestation key (sent in X-Mobile-App-Key header)
# MOBILE_API_KEY=

# Optional overrides
# PORT=5002
# DATA_DIR=/app/data

